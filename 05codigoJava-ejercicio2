import java.util.Scanner;

public class Ejercicio2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double totalVendido = 0, totalDescontado = 0;
        int ventasRechazadas = 0;

        System.out.print("Ingrese el numero de ventas (N): ");
        int N = sc.nextInt();

        for (int i = 1; i <= N; i++) {
            System.out.println("\n--- Venta " + i + " ---");

            System.out.print("Codigo: ");
            String codigo = sc.next();
            System.out.print("Nombre: ");
            String nombre = sc.next();

            // Validacion de precio
            double precio;
            do {
                System.out.print("Precio (>0): ");
                precio = sc.nextDouble();
            } while (precio <= 0);

            // Categoria usando switch
            System.out.print("Categoria (1.Analgesico, 2.Antibiotico, 3.Vitamina, 4.Otro): ");
            int cat = sc.nextInt();
            String nomCat = "";
            switch (cat) {
                case 1: nomCat = "Analgesico"; break;
                case 2: nomCat = "Antibiotico"; break;
                case 3: nomCat = "Vitamina"; break;
                default: nomCat = "Otro"; break;
            }

            // Validacion de cantidad
            int cant;
            do {
                System.out.print("Cantidad (>0): ");
                cant = sc.nextInt();
            } while (cant <= 0);

            // Validacion de receta con IF
            System.out.print("¿Requiere receta? (1:Si / 0:No): ");
            int reqReceta = sc.nextInt();
            int presReceta = 0;
            if (reqReceta == 1) {
                System.out.print("¿Presenta receta? (1:Si / 0:No): ");
                presReceta = sc.nextInt();
            }

            // Control de Venta Rechazada / Aprobada
            if (reqReceta == 1 && presReceta == 0) {
                System.out.println("-> VENTA RECHAZADA (Falta receta)");
                ventasRechazadas++;
            } else {
                double subtotal = precio * cant;
                double desc = 0;

                // Descuento por cantidad con IF
                if (cant >= 10) {
                    desc = subtotal * 0.15;
                } else if (cant >= 5) {
                    desc = subtotal * 0.08;
                }

                double total = subtotal - desc;
                totalVendido += total;
                totalDescontado += desc;

                System.out.println("-> Subtotal: $" + subtotal + " | Desc: $" + desc + " | Total: $" + total);
            }
        }

        // Resumen Final
        System.out.println("\n=== RESUMEN GENERAL ===");
        System.out.println("Total Vendido: $" + totalVendido);
        System.out.println("Total Descontado: $" + totalDescontado);
        System.out.println("Ventas Rechazadas: " + ventasRechazadas);

        sc.close();
    }
}
